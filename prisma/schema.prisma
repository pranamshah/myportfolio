generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ShipmentMode {
  SEA
  AIR
}

enum Movement {
  IMPORT
  EXPORT
}

enum ShipmentStatus {
  BOOKING_CONFIRMED
  CARGO_PICKED_UP
  AT_CFS
  ON_VESSEL
  IN_TRANSIT
  ARRIVED_AT_PORT
  UNDER_CUSTOMS_EXAMINATION
  CUSTOMS_CLEARED
  DELIVERED
  COMPLETED
}

enum InvoiceType {
  SERVICE
  REIMBURSEMENT
  DO
  CFS
  TRANSPORT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
}

enum PartnerType {
  CHA
  CFS
  SHIPPING_LINE
  TRANSPORTER
  OTHER
}

enum DocumentType {
  BL
  PACKING_LIST
  COMMERCIAL_INVOICE
  BILL_OF_ENTRY
  GATEPASS
  DELIVERY_ORDER
  EWAY_BILL
  DUTY_PAYMENT
  CFS_INVOICE
  TRANSPORT_INVOICE
  INSURANCE
  COO
  OTHER
}

enum ChargeCategory {
  SHIPPING_LINE
  CFS_PORT
  TRANSPORT
  CUSTOMS_DUTY
  CHA_COORDINATION
  OUR_FEES
  MISCELLANEOUS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  company   String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments  Shipment[]
  invoices   Invoice[]
  quotes     Quote[]
  documents  Document[]
  tickets    Ticket[]
  accounts   Account[]
  sessions   Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Shipment {
  id              String         @id @default(cuid())
  jobNo           String         @unique
  clientId        String
  client          User           @relation(fields: [clientId], references: [id])
  mode            ShipmentMode
  movement        Movement
  status          ShipmentStatus @default(BOOKING_CONFIRMED)
  blNo            String?
  awbNo           String?
  beNo            String?
  beDate          DateTime?
  mblNo           String?
  hblNo           String?
  vessel          String?
  voyage          String?
  liner           String?
  portLoading     String?
  portDischarge   String?
  finalDest       String?
  cargoDesc       String?
  hsCode          String?
  packages        Int?
  grossWeight     Float?
  cbm             Float?
  assessValue     Float?
  dutyAmount      Float?
  chaName         String?
  examType        String?
  cfsName         String?
  gateinDate      DateTime?
  destuffDate     String?
  storageFree     Int?
  storageCharges  Float?
  bookingDate     DateTime?
  sailDate        DateTime?
  eta             DateTime?
  arrivalDate     DateTime?
  clearanceDate   DateTime?
  deliveryDate    DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  containers      Container[]
  documents       Document[]
  charges         Charge[]
  invoices        Invoice[]
  trackingUpdates TrackingUpdate[]
  tickets         Ticket[]
}

model Container {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerNo String
  sealNo      String?
  size        String?
  type        String?
  tareWeight  Float?
  createdAt   DateTime @default(now())
}

model Document {
  id          String       @id @default(cuid())
  shipmentId  String
  shipment    Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type        DocumentType
  label       String
  filePath    String
  uploadedBy  String
  uploader    User         @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime     @default(now())
}

model Charge {
  id            String         @id @default(cuid())
  shipmentId    String
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  category      ChargeCategory
  name          String
  sacCode       String?
  units         Float          @default(1)
  rate          Float
  taxableAmt    Float
  cgstRate      Float          @default(0)
  sgstRate      Float          @default(0)
  igstRate      Float          @default(0)
  totalAmt      Float
  paidBy        String?
  vendorName    String?
  refInvoiceNo  String?
  createdAt     DateTime       @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  shipmentId  String
  shipment    Shipment      @relation(fields: [shipmentId], references: [id])
  clientId    String
  client      User          @relation(fields: [clientId], references: [id])
  type        InvoiceType
  date        DateTime      @default(now())
  dueDate     DateTime?
  items       Json
  subtotal    Float
  cgst        Float         @default(0)
  sgst        Float         @default(0)
  igst        Float         @default(0)
  total       Float
  status      InvoiceStatus @default(DRAFT)
  pdfPath     String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Quote {
  id          String      @id @default(cuid())
  clientId    String?
  client      User?       @relation(fields: [clientId], references: [id])
  name        String
  email       String
  phone       String
  company     String?
  mode        String
  movement    String
  origin      String
  destination String
  cargoType   String
  weight      Float?
  cbm         Float?
  packages    Int?
  notes       String?
  status      QuoteStatus @default(PENDING)
  quotedAmt   Float?
  quotedNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Partner {
  id        String      @id @default(cuid())
  name      String
  type      PartnerType
  contact   String?
  email     String?
  phone     String?
  gst       String?
  address   String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TrackingUpdate {
  id            String         @id @default(cuid())
  shipmentId    String
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status        ShipmentStatus
  note          String?
  notifyClient  Boolean        @default(false)
  createdAt     DateTime       @default(now())
}

model Ticket {
  id         String       @id @default(cuid())
  clientId   String
  client     User         @relation(fields: [clientId], references: [id])
  shipmentId String?
  shipment   Shipment?    @relation(fields: [shipmentId], references: [id])
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
