generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CLIENT")
  phone     String?
  company   String?
  gst       String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments  Shipment[]
  invoices   Invoice[]
  quotes     Quote[]
  documents  Document[]
  vouchers   Voucher[]
}

model Shipment {
  id              String    @id @default(cuid())
  shipmentId      String    @unique
  clientId        String
  client          User      @relation(fields: [clientId], references: [id])
  description     String
  origin          String
  destination     String
  portOfLoading   String    @default("")
  portOfDischarge String    @default("")
  vessel          String?
  voyageNo        String?
  blNo            String?
  containerNo     String?
  sealNo          String?
  packages        Int?
  grossWeight     Float?
  cbm             Float?
  commodity       String?
  incoterms       String?
  status          String    @default("BOOKING_CONFIRMED")
  etd             DateTime?
  eta             DateTime?
  actualDeparture DateTime?
  actualArrival   DateTime?
  notes           String?
  timeline        Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices  Invoice[]
  documents Document[]
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNo     String    @unique
  invoiceType   String
  shipmentId    String?
  shipment      Shipment? @relation(fields: [shipmentId], references: [id])
  clientId      String
  client        User      @relation(fields: [clientId], references: [id])
  invoiceDate   DateTime
  dueDate       DateTime?
  lineItems     Json      @default("[]")
  subtotal      Float
  cgst          Float?
  sgst          Float?
  igst          Float?
  tds           Float?
  totalAmount   Float
  amountPaid    Float     @default(0)
  status        String    @default("DRAFT")
  notes         String?
  paymentMethod String?
  paymentDate   DateTime?
  paymentRef    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Quote {
  id                 String    @id @default(cuid())
  quoteNo            String    @unique
  clientId           String
  client             User      @relation(fields: [clientId], references: [id])
  origin             String
  destination        String
  cargoType          String
  incoterms          String?
  weight             Float?
  cbm                Float?
  packages           Int?
  commodity          String?
  additionalServices Json      @default("[]")
  remarks            String?
  quotedAmount       Float?
  validUntil         DateTime?
  status             String    @default("PENDING")
  adminNotes         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Document {
  id                String   @id @default(cuid())
  shipmentId        String
  shipment          Shipment @relation(fields: [shipmentId], references: [id])
  uploadedById      String
  uploadedBy        User     @relation(fields: [uploadedById], references: [id])
  name              String
  originalName      String
  fileType          String
  fileSize          Int
  filePath          String
  category          String   @default("OTHER")
  description       String?
  isVisibleToClient Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Ledger {
  id             String    @id @default(cuid())
  name           String    @unique
  group          String
  type           String
  openingBalance Float     @default(0)
  openingType    String    @default("DR")
  description    String?
  isSystem       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  voucherEntries VoucherEntry[]
}

model Voucher {
  id          String         @id @default(cuid())
  voucherNo   String         @unique
  voucherType String
  date        DateTime
  narration   String
  entries     VoucherEntry[]
  totalAmount Float
  reference   String?
  attachments Json           @default("[]")
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model VoucherEntry {
  id         String  @id @default(cuid())
  voucherId  String
  voucher    Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId   String
  ledger     Ledger  @relation(fields: [ledgerId], references: [id])
  ledgerName String
  type       String
  amount     Float
  narration  String?
}
